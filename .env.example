# Enterprise Quality & Sanitizer Toolkit Configuration Template
# Copy this file to .env and customize values as needed for your environment.

# ==========================================
# Application & Environment Settings
# ==========================================
APP_NAME=my-repo
APP_ENV=development
APP_PORT=3000

# ==========================================
# Relative Workspace Paths (Portable across OS)
# ==========================================
# All paths are dynamically resolved relative to the repository root.
REPO_ROOT=.
DATA_DIR=./src/data
OUTPUT_DIR=./dist
LOG_DIR=./tests/reports/logs
REPORTS_DIR=./tests/reports

# ==========================================
# Sanitizer & Path Scrubbing Configuration
# ==========================================
# Legacy string tokens to sanitize automatically across scripts & tests
TARGET_LEGACY_NAME=my-repo
TARGET_CLEAN_NAME=my-repo

# Forbidden absolute path patterns (used by static scanners to enforce portability)
FORBIDDEN_PATH_PATTERNS=/Users/,/home/,C:\Users\

# ==========================================
# Quality Assurance & Testing Gates
# ==========================================
ENABLE_STRICT_TYPING=true
ENABLE_MUTATION_TESTING=true
ENABLE_HYGIENE_SCAN=true
STRICT_PATH_SCRUB_CHECK=true
LOG_LEVEL=info

# ==========================================
# Pytest Discovery Control (env-driven, not hardcoded in pyproject.toml)
# ==========================================
# Extra args passed to `addopts` in [tool.pytest.ini_options].
# Exclude broken-by-design sample dirs from collection while keeping them on disk.
# Reviewer: set PYTEST_EXTRA_ARGS to "" (empty) to re-enable full collection.
PYTEST_EXTRA_ARGS=--ignore=tests/math_chapters --ignore=tests/param_flows --ignore=tests/infra
