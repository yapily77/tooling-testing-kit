# Enterprise Quality Toolkit - Environment Configuration Example
# Copy this file to .env and configure your local values

# Repository and Project Identification
APP_NAME=my-repo
APP_ENV=development
APP_PORT=3000

# Base Paths & Directories (Configurable to prevent hardcoding)
REPO_ROOT=./
DATA_DIR=./src/data
OUTPUT_DIR=./dist
LOG_DIR=./tests/reports/logs

# Legacy Replacement Target (e.g., replacement for legacy 'baziforecaster')
TARGET_LEGACY_NAME=baziforecaster
TARGET_CLEAN_NAME=my-repo

# Quality Gates & Feature Flags
ENABLE_STRICT_TYPING=true
ENABLE_HARDCODED_PATH_SCRUBBER=true
ENABLE_MUTATION_TESTING=true
ENABLE_HYGIENE_SCANNER=true
LOG_LEVEL=info
