{
  "name": "clean_ts",
  "version": "1.0.0",
  "description": "Deterministically verifies TypeScript code against strict quality constraints (AST policy, tsc strict, ESLint-equivalent rules, cyclomatic complexity, type safety) before writing to disk.",
  "bin": {
    "clean_ts": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p='dist/cli.js';const c=fs.readFileSync(p,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c);fs.chmodSync(p,0o755);\"",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^12.0.0"
  }
}
