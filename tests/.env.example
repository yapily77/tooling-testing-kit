# Copy to .env and fill the kit values. Leave kit live off (false) for offline examples.
KIT_LIVE=false
KIT_PATH=/home/user/kit-tests
KIT_BASE_URL=http://localhost:8000
KIT_MODEL=mock-chrono-model
KIT_MEM0_MODEL=mock-mem0-model
KIT_API_KEY=YOUR-API-KEY-HERE
SENTRY_DSN=
DISABLE_SENTRY=1
LOGFIRE_NO_PLACEHOLDER=true
LOGFIRE_IGNORE_MISSING_DATA_KEYS=true
DATABASE_URL=
