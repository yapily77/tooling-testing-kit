{
  "name": "enterprise-quality-toolkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:unit": "vitest run tests/02_unit_bedrock",
    "test:e2e": "vitest run tests/05_integration_e2e",
    "test:coverage": "vitest run --coverage",
    "hygiene": "tsx hygiene/daily/preflight.ts",
    "scrub-check": "tsx hygiene/scanners/path_scrub_check.ts",
    "analyze": "tsx tools/codebase/analyzer.ts",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^3.0.5"
  }
}
