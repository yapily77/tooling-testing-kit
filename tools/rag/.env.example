# ─── RAG Runtime Configuration ─────────────────────────────────────
# Copy to .env and edit values. All optional except where noted.

# LLM model for query translation (required at query time)
RAG_MODEL=openai/gpt-4o-mini

# BGE-M3 embedding server URL (the text-embeddings-inference router)
BGEM3_URL=http://localhost:8002/v1/embeddings
BGEM3_TOKEN=

# TurboVec vector index location (built by run_rag_pipeline.py)
TURBOVEC_INDEX_PATH=./data/bazi_index.tv

# SQLite metadata database location
BAZI_SQLITE_PATH=./data/bazi_metadata.db

# Qdrant local path (used by mcp_bazirag.py)
QDRANT_PATH=./data/qdrant_db
COLLECTION_NAME=bazi_classical

# Redis cache (optional — set REDIS_HOST=disabled to skip)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_TTL_EMBEDDING=86400
REDIS_TTL_QUERY=3600

# Local data directory (texts must live here for the ingestion pipeline)
RAG_DATA_DIR=./data