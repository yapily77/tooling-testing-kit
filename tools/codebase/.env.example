# === REQUIRED ===
KIT_TARGET_ROOT=/path/to/your/target/repo

# === OPTIONAL ===
KIT_CODEBASE_MODEL=google/gemini-2.0-flash       # LLM for query translation
KIT_QDRANT_URL=http://localhost:6333             # For embedding-powered semantic search
KIT_QDRANT_TOKEN=                                # Bearer token for Qdrant if needed
KIT_COLLECTION_NAME=codebase_index               # Qdrant collection name
KIT_INFRA_ROOT=/path/to/infra                   # For knowledge graph (optional)
