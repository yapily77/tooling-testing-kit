# kit-hygiene — user-downloads / configure-and-run contract.
# Install:  cp hygiene/.env.example hygiene/.env   (then EDIT; .env is NOT version-controlled)
# Run:      uv run hygiene/scanners/run_all.py          (gated by HARD_FAIL_THRESHOLD below)

# --- Paths (fail-fast: scanner exits non-zero if a configured root is missing) ---
AIB_FACTORY_ROOT=<path>/ai-factory                  # repo root holding hygiene/ (and optional kit-tests/ kit-tools/)
SCAN_ROOTS=./                              # comma list; relative to AIB_FACTORY_ROOT OR absolute (mix allowed). For a single target repo, set to the target's src dir, e.g. TARGET_REPO/src
TARGET_ROOT=                      # repo being scanned (contains src2/ or your own code). Required for scanners needing src2.* schema (registry_clashes, message_drift, verify_dict_access_runtime). Omit only when scanning kit-* dirs themselves.
HYGIENE_FILES_TO_SCAN=           # optional override; comma list of paths to scan (see scanners/utils.py get_src2_files)
PATH_LEAK_ROOTS=/home,/mnt,/Users                   # hard-coded roots these scanners must NOT emit (PORTABILITY_REVIEW if hit)  # REVIEW per-host
PATH_LEAK_ALLOWLIST=                                  # exemptions; empty by default

# --- Hygiene thresholds (integers; "" = no limit / disabled) ---
HARD_FAIL_THRESHOLD=2            # 0=noop, 1=warn-and-continue, >=2=exit 1  (Fail Loudly)
SECRET_MAX_LINE=                 # max lines scanned per file by scanners/find_secrets.py ; "" = whole file
DUPE_THRESHOLD_PCT=100           # identity % for dup-check verdict=DUPLICATE (100 = byte-identical only)

# --- Runtime toggles (feature gates) ---
ENABLE_DAILY_CHECKS=false        # daily/*.py cron-style checks
KIT_ENABLE_REGISTRY_CLASHES=false    # find_registry_clashes.py (needs KIT_* below)

# --- External service credentials (place secrets HERE, never in code) ---
# Configure these if you are running the registry_clashes LLM audit. Leave disabled otherwise.
# KIT_BASE_URL: Endpoint of your local router/LM proxy. Default assumes a local Antigravity manager.
KIT_BASE_URL=http://localhost:40142  # override as needed; see KIT_BASE_URL comment below
KIT_API_KEY=                                       # <-- REQUIRED when KIT_ENABLE_REGISTRY_CLASHES=true ; fail-fast if empty
KIT_MODEL=gemma-4-31b-it                           # model name passed to your router endpoint

# --- Portable tool runtime (Option A: install list. Leave empty to use the vendored no-dep loader) ---
PYTHON_DEPS=python-dotenv,hypothesis,pytest
